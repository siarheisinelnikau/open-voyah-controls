<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RadioTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/radio_background</item>
        <item name="android:statusBarColor">@color/radio_background</item>
        <item name="android:navigationBarColor">@color/radio_background</item>
        <item name="android:colorAccent">?attr/radio_accent_role</item>
        <item name="radio_accent_role">@color/radio_accent</item>
        <item name="radio_on_accent_role">@color/radio_on_accent</item>
        <item name="radio_selected_role">@color/radio_selected</item>
        <item name="radio_selected_edge_role">@color/radio_selected_edge</item>
        <item name="radio_edge_role">@color/radio_edge</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="RadioTheme.Amber" parent="RadioTheme">
        <item name="radio_accent_role">#F5CF71</item>
        <item name="radio_on_accent_role">#362400</item>
        <item name="radio_selected_role">#4F3913</item>
        <item name="radio_selected_edge_role">#785E36</item>
        <item name="radio_edge_role">#3F3B38</item>
    </style>
</resources>
