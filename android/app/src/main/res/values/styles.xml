<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/cockpit_accent</item>
        <item name="android:colorBackground">@color/cockpit_background</item>
        <item name="android:colorBackgroundFloating">@color/cockpit_surface</item>
        <item name="android:textColorPrimary">@color/cockpit_text</item>
        <item name="android:textColorSecondary">@color/cockpit_muted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/cockpit_background</item>
        <item name="android:navigationBarColor">@color/cockpit_background</item>
        <item name="android:windowBackground">@color/cockpit_background</item>
        <item name="android:buttonStyle">@style/CockpitButton</item>
        <item name="android:windowAnimationStyle">@style/CockpitWindowMotion</item>
    </style>

    <style name="CockpitButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/cockpit_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/cockpit_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="CockpitWindowMotion" parent="android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cockpit_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/cockpit_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/cockpit_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/cockpit_exit</item>
    </style>

    <style name="CockpitDialogTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/CockpitDialogMotion</item>
    </style>

    <style name="CockpitDialogMotion" parent="android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/cockpit_enter</item>
        <item name="android:windowExitAnimation">@anim/cockpit_exit</item>
    </style>

    <style name="QuickVoiceTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/cockpit_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@style/QuickVoiceMotion</item>
    </style>

    <style name="QuickVoiceMotion" parent="android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/cockpit_voice_enter</item>
        <item name="android:windowExitAnimation">@anim/cockpit_voice_exit</item>
    </style>
</resources>
